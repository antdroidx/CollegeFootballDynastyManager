<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DynastyManager.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>College Football Dynasty Manager</ApplicationTitle>
    <ApplicationId>antdroid.cfbcoach</ApplicationId>
    <ApplicationDisplayVersion>0.20.0</ApplicationDisplayVersion>
    <ApplicationVersion>400</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationTitle>College Football Dynasty Manager</ApplicationTitle>
    <ApplicationId>antdroid.cfbcoach.dev</ApplicationId>

    <!-- GitHub/standalone debug APKs are sideloaded without Visual Studio Fast Deployment. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- Keep CI/dev APKs signed with one stable development certificate so updates install in-place. -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\..\build\keys\cfdm-dev.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>cfdm-dev</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>cfdmdev</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>cfdm-dev</AndroidSigningKeyPass>

  </PropertyGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\dynasty_logo.png" BaseSize="240,240" />
    <MauiIcon Include="Resources\AppIcon\appicon_purple.png" BaseSize="256,256" />
    <MauiSplashScreen Include="Resources\Splash\splash_cfdm.png"
                      Color="#211039"
                      BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Football.Engine\Football.Engine.csproj" />
    <ProjectReference Include="..\Football.Presentation\Football.Presentation.csproj" />
    <ProjectReference Include="..\DynastyManager.Data\DynastyManager.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="Resources\Raw\coaches-2025.csv" LogicalName="coaches_2025.csv" />
    <MauiAsset Include="Resources\Raw\next26-aug26-2025.csv" LogicalName="next26_roster.csv" />
    <MauiAsset Include="..\DynastyManager.Data\Resources\Legacy\universe.csv" LogicalName="legacy_universe.csv" />
    <MauiAsset Include="..\DynastyManager.Data\Resources\Legacy\roster.csv" LogicalName="legacy_roster.csv" />
    <MauiAsset Include="..\DynastyManager.Data\Resources\Legacy\coach.csv" LogicalName="legacy_coach.csv" />
  </ItemGroup>
</Project>
